# Public site URL (canonical, OG, sitemap)
VITE_SITE_URL=https://www.aardvarktanzania.com

# Brand films — MP4 on CDN, or paste a YouTube link (see docs/EXTERNAL-VIDEOS.md)
# By default the site loads films from the production CDN (no local MP4s required in dev).
# VITE_VIDEO_CDN_BASE=https://media.aardvarktanzania.com
# VITE_USE_LOCAL_VIDEOS=true
# “Watch the Film” modal (aardvark-raw-footage.mp4 on R2, or YouTube override)
# VITE_VIDEO_RAW_FOOTAGE=https://www.youtube.com/watch?v=YOUR_ID
# VITE_VIDEO_FEATURE_FILM=https://www.youtube.com/watch?v=YOUR_VIDEO_ID
# VITE_VIDEO_WILD_REEL=https://www.youtube.com/watch?v=YOUR_VIDEO_ID
# VITE_VIDEO_GORILLA=https://www.youtube.com/watch?v=YOUR_VIDEO_ID

# R2 upload script only (npm run upload-videos) — not used by the app
# R2_BUCKET_NAME=aardvark-media
# CLOUDFLARE_ACCOUNT_ID=

# Optional: Plausible analytics (loaded after cookie consent)
# VITE_PLAUSIBLE_DOMAIN=aardvarktanzania.com

# Cloudflare Turnstile (https://dash.cloudflare.com → Turnstile)
# Site key is public; secret stays server-only.
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Comma-separated extra allowed origins for form POST (e.g. staging)
# ALLOWED_ORIGINS=https://staging.aardvarktanzania.com

# Local dev only: skip Turnstile when keys are unset (never set in production)
# ALLOW_INSECURE_FORMS=true

# Server-only: Resend API for enquiry forms (https://resend.com)
RESEND_API_KEY=re_xxxxxxxx
ENQUIRY_TO_EMAIL=info@aardvarktanzania.com
ENQUIRY_FROM_EMAIL=Aardvark Safaris <info@aardvarktanzania.com>

# Required in production for plan-trip, contact, package & newsletter forms.
# Guests receive an automatic confirmation email after a successful enquiry.
# Rotate RESEND_API_KEY immediately if it was ever committed or shared.
